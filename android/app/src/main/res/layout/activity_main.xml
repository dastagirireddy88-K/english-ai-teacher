<?xml version="1.0" encoding="utf-8"?><ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"><TextView android:text="🧑‍🏫 My AI English Teacher" android:textSize="27sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:text="Speak • Correct • Learn • Repeat" android:textSize="15sp" android:paddingTop="5dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><Spinner android:id="@+id/mode" android:entries="@array/modes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/><Spinner android:id="@+id/level" android:entries="@array/levels" android:layout_width="match_parent" android:layout_height="wrap_content"/><EditText android:id="@+id/input" android:hint="Speak or type your answer..." android:gravity="top" android:minLines="5" android:layout_width="match_parent" android:layout_height="wrap_content"/><LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/speak" android:text="🎤 Speak" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/><Button android:id="@+id/ask" android:text="🧑‍🏫 Ask" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/></LinearLayout><Button android:id="@+id/listen" android:text="🔊 Teacher Voice" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/progress" android:text="Today's lesson: 0/20 minutes" android:textStyle="bold" android:paddingTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/output" android:text="Start your practice. I will correct you, teach vocabulary, and ask you to try again." android:textSize="16sp" android:padding="15dp" android:layout_marginTop="10dp" android:background="#F2F2F2" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout></ScrollView>